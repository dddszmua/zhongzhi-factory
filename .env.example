# 浏览器侧 API 前缀（开发默认走 Vite 代理 /api）
VITE_API_BASE_URL=/api
VITE_AGENT_BASE_URL=

# 开发服务器代理目标（改完需重启 npm run dev）
# 默认线上：
VITE_DEV_API_PROXY=https://fdueblab.cn
VITE_DEV_AGENT_PROXY=https://fdueblab.cn

# 可选：改连本地 backend / agent
# VITE_DEV_API_PROXY=http://127.0.0.1:5000
# VITE_DEV_AGENT_PROXY=http://127.0.0.1:8010
